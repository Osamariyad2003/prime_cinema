# Copy this file to .env and fill in real values.
# All variables MUST be prefixed with VITE_ or Vite will not expose them to client code.

# Backend API base URL (defaults to the deployed Render backend if omitted).
VITE_API_BASE_URL=https://prime-cinema-backend-1.onrender.com/api

# Stripe publishable key (safe to expose to the browser — this is NOT the secret key).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Unsplash "Access Key" for client-side demo image requests (rate-limited, safe to expose).
VITE_UNSPLASH_ACCESS_KEY=...
